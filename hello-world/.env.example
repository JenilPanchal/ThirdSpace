# Copy to .env.local and add your own YouTube Data API v3 key.
# Start with: node --env-file=.env.local server/room-server.mjs
YOUTUBE_API_KEY=
# Set only when deploying this server to a public HTTPS host:
# THIRD_SPACE_PUBLIC_URL=https://your-host

# Bee private bench: set an 8+ character code you enter on the TV.
BEE_ACCESS_CODE=
# A private, stable random namespace for this signed-in Bee account's corrections.
# Use a new value when changing the Bee account on the host computer.
BEE_PROFILE_KEY=
# Optional: Bee agent mind maps require a Bee test-user account.
# Otherwise maps are created directly from reviewed transcript turns.
BEE_AGENT_ENABLED=0
